# MongoDB Atlas connection string (Mongoose)
MONGO_URI=mongodb+srv://username:password@cluster0.mongodb.net/tutor_db?retryWrites=true&w=majority

# JWT secret key for token signing and authentication middleware
JWT_SECRET=ai_tutor_super_secret_jwt_key_2026

# Cloudinary cloud name for raw PDF/PPTX/DOCX document uploads
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# Cloudinary API key
CLOUDINARY_API_KEY=your_cloudinary_api_key

# Cloudinary API secret
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Gemini API key — used as the primary LLM for grounded RAG answers and quiz generation
# Get one free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# Groq API key — used as the automatic LLM fallback if Gemini errors or rate-limits
# Get one free at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key

# URL of the Python RAG microservice (FastAPI + ChromaDB + sentence-transformers)
# Run it with: cd ml_service && uvicorn main:app --host 0.0.0.0 --port 8001
RAG_SERVICE_URL=http://localhost:8001

# Absolute or relative path where ChromaDB persists its vector index on disk
# This directory is created automatically on first run; commit it to .gitignore
CHROMA_PERSIST_DIR=./chroma_data

# Minimum confidence score [0–1] for a RAG answer to be returned to the student.
# Below this threshold the question is escalated to faculty instead of answered.
# Lower values = more permissive; recommended range 0.4–0.6
CONFIDENCE_THRESHOLD=0.55

# Frontend build-time API base URL (set in Vercel to the Render API URL)
VITE_API_BASE=https://adeptive-learning-api.onrender.com

# Browser origins allowed to call the backend (comma-separated; set in Render)
FRONTEND_URL=https://your-project.vercel.app
CORS_ORIGINS=https://your-project.vercel.app
